{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter", "inputs_present", "inputs_missing", "clusters", "dropped", "grade_opinions"],
  "properties": {
    "chapter":        { "type": "string" },
    "inputs_present": { "type": "integer" },
    "inputs_missing": { "type": "array", "items": { "type": "string" } },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cluster_id", "file", "quote", "category", "severity", "confidence", "claim", "conflict", "supporters"],
        "properties": {
          "cluster_id":    { "type": "string" },
          "file":          { "type": "string" },
          "quote":         { "type": "string" },
          "category":      { "type": "string" },
          "severity":      { "type": "string", "enum": ["치명", "높음", "중간", "낮음"] },
          "confidence":    { "type": "string", "enum": ["확실", "추정"] },
          "claim":         { "type": "string" },
          "conflict":      { "type": "boolean" },
          "conflict_note": { "type": "string" },
          "supporters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["agent", "model", "seq"],
              "properties": {
                "agent": { "type": "string" },
                "model": { "type": "string" },
                "seq":   { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent", "model", "seq", "reason"],
        "properties": {
          "agent":  { "type": "string" },
          "model":  { "type": "string" },
          "seq":    { "type": "integer" },
          "reason": { "type": "string" }
        }
      }
    },
    "grade_opinions": { "type": "object" }
  }
}
