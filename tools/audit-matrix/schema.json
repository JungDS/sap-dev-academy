{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "model", "target", "persona_ack", "method", "errors", "files_read", "findings", "overall"],
  "properties": {
    "agent":       { "type": "string", "enum": ["AG01","AG02","AG03","AG04","AG05","AG06","AG07","AG08","AG09"] },
    "model":       { "type": "string", "enum": ["opus","sonnet","gpt-5.6-sol","gemini-3.6-flash-high","gemini-3.7-flash-high"] },
    "target":      { "type": "string" },
    "persona_ack": { "type": "string" },
    "method":      { "type": "string", "description": "실제 사용한 검증 수단(도구 미사용 종은 빈 문자열 가능) — 도구를 쓰는 종(특히 AG02)은 반드시 기입" },
    "errors":      { "type": "array", "items": { "type": "string" }, "description": "부분 실패 사유(없으면 빈 배열) — 작업이 일부 실패해도 스키마를 유지하고 여기에 기록" },
    "files_read":  { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "file", "quote", "category", "severity", "confidence", "claim", "evidence", "suggestion"],
        "properties": {
          "seq":        { "type": "integer" },
          "file":       { "type": "string" },
          "quote":      { "type": "string", "maxLength": 240 },
          "category":   { "type": "string" },
          "severity":   { "type": "string", "enum": ["치명", "높음", "중간", "낮음"] },
          "confidence": { "type": "string", "enum": ["확실", "추정"] },
          "claim":      { "type": "string" },
          "evidence":   { "type": "string" },
          "suggestion": { "type": "string", "description": "수정 방향(없으면 빈 문자열)" }
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade_opinion", "summary"],
      "properties": {
        "grade_opinion": { "type": "string", "enum": ["유지", "경미 수정", "보강 권장", "재집필 권장"] },
        "summary":       { "type": "string" }
      }
    }
  }
}
